{
  "name": "Parallax",
  "version": "0.1.0",
  "private": true,
  "description": "Jev-powered arXiv literature search tool",
  "license": "Apache-2.0",
  "homepage": "https://parallax.ink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilize/parallax-dsh.git"
  },
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "skills",
    "cordis.patch.yml",
    "locale",
    "assets",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "smoke": "node smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xyflow/react": "^12.3.0",
    "elkjs": "^0.12.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "undici": "^7.30.1"
  }
}
